<!-- URDF for M-810/270-27B -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro
    name="m810_270_27b"
    params="prefix=''
            parent
            *origin
            child"
  >

    <xacro:property name="j1_lower_limit" value="${radians(-165)}" />
    <xacro:property name="j2_lower_limit" value="${radians(-75)}" />
    <xacro:property name="j3_lower_limit" value="${radians(-79)}" />
    <xacro:property name="j4_lower_limit" value="${radians(-153)}" />
    <xacro:property name="j5_lower_limit" value="${radians(-120)}" />
    <xacro:property name="j6_lower_limit" value="${radians(-360)}" />

    <xacro:property name="j1_upper_limit" value="${radians(165)}" />
    <xacro:property name="j2_upper_limit" value="${radians(96)}" />
    <xacro:property name="j3_upper_limit" value="${radians(90)}" />
    <xacro:property name="j4_upper_limit" value="${radians(153)}" />
    <xacro:property name="j5_upper_limit" value="${radians(120)}" />
    <xacro:property name="j6_upper_limit" value="${radians(360)}" />

    <xacro:property name="j1_effort_limit" value="30000" />
    <xacro:property name="j2_effort_limit" value="30000" />
    <xacro:property name="j3_effort_limit" value="30000" />
    <xacro:property name="j4_effort_limit" value="6000" />
    <xacro:property name="j5_effort_limit" value="6000" />
    <xacro:property name="j6_effort_limit" value="3000" />

    <xacro:property name="j1_velocity_limit" value="${radians(100)}" />
    <xacro:property name="j2_velocity_limit" value="${radians(80)}" />
    <xacro:property name="j3_velocity_limit" value="${radians(80)}" />
    <xacro:property name="j4_velocity_limit" value="${radians(120)}" />
    <xacro:property name="j5_velocity_limit" value="${radians(115)}" />
    <xacro:property name="j6_velocity_limit" value="${radians(200)}" />

    <!-- links -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/visual/base.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/collision/base.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 238" />
        <origin xyz="-.127 -.00127  .142" />
        <inertia
          ixx=" 8.11"
          ixy=" .156"
          ixz="-.283"
          iyy=" 16.3"
          iyz=" .0399"
          izz=" 20.7"
        />
      </inertial>
    </link>

    <link name="${prefix}J1_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/visual/j1.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/collision/j1.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 334" />
        <origin xyz=" .0992 -.00673 -.13" />
        <inertia
          ixx=" 16.9"
          ixy=" .385"
          ixz="-3.07"
          iyy=" 20.2"
          iyz=" .743"
          izz=" 21.7"
        />
      </inertial>
    </link>

    <link name="${prefix}J2_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/visual/j2.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/collision/j2.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 296" />
        <origin xyz=" .0101  .268  .476" />
        <inertia
          ixx=" 48.7"
          ixy=" .0564"
          ixz="-1.18"
          iyy=" 48.9"
          iyz="-2.3"
          izz=" 6.52"
        />
      </inertial>
    </link>

    <link name="${prefix}J3_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/visual/j3.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/collision/j3.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 473" />
        <origin xyz=" .255  .0575  .151" />
        <inertia
          ixx=" 20"
          ixy=" 1.27"
          ixz="-4.4"
          iyy=" 62.8"
          iyz=" 1.17"
          izz=" 65.6"
        />
      </inertial>
    </link>

    <link name="${prefix}J4_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/visual/j4.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/collision/j4.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 48.2" />
        <origin xyz=" 1.08  .0482  .0456" />
        <inertia
          ixx=" .566"
          ixy=" .0479"
          ixz=" .232"
          iyy=" 1.19"
          iyz="-.0335"
          izz=" 1.23"
        />
      </inertial>
    </link>

    <link name="${prefix}J5_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/visual/j5.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/collision/j5.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 38.2" />
        <origin xyz=" .0656  .0126  .0000000911" />
        <inertia
          ixx=" .55"
          ixy="-.0402"
          ixz="-.000000554"
          iyy=" .434"
          iyz=" .00000095"
          izz=" .711"
        />
      </inertial>
    </link>

    <link name="${prefix}J6_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/visual/j6.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://fanuc_m810_description/meshes/m810_270_27b/collision/j6.stl"
          />
        </geometry>
      </collision>
      <inertial>
        <mass value=" 2.81" />
        <origin xyz=" .231 -.00000142 -.00000316" />
        <inertia
          ixx=" .0164"
          ixy=" .0000000217"
          ixz="-.00000000848"
          iyy=" .00875"
          iyz=" .0000000000127"
          izz=" .00875"
        />
      </inertial>
    </link>

    <!-- joints -->
    <joint name="${prefix}J1" type="revolute">
      <origin xyz=" 0  0  .67" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}J1_link" />
      <axis xyz=" 0  0  1" />
      <limit
        lower="${j1_lower_limit}"
        upper="${j1_upper_limit}"
        effort="${j1_effort_limit}"
        velocity="${j1_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}J2" type="revolute">
      <origin xyz=" .312  0  0" rpy="0 0 0" />
      <parent link="${prefix}J1_link" />
      <child link="${prefix}J2_link" />
      <axis xyz=" 0  1  0" />
      <limit
        lower="${j2_lower_limit}"
        upper="${j2_upper_limit}"
        effort="${j2_effort_limit}"
        velocity="${j2_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}J3" type="revolute">
      <origin xyz=" 0  0  1.075" rpy="0 0 0" />
      <parent link="${prefix}J2_link" />
      <child link="${prefix}J3_link" />
      <axis xyz=" 0 -1  0" />
      <limit
        lower="${j3_lower_limit}"
        upper="${j3_upper_limit}"
        effort="${j3_effort_limit}"
        velocity="${j3_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}J4" type="revolute">
      <origin xyz=" 0  0  .225" rpy="0 0 0" />
      <parent link="${prefix}J3_link" />
      <child link="${prefix}J4_link" />
      <axis xyz="-1  0  0" />
      <limit
        lower="${j4_lower_limit}"
        upper="${j4_upper_limit}"
        effort="${j4_effort_limit}"
        velocity="${j4_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}J5" type="revolute">
      <origin xyz=" 1.28  0  0" rpy="0 0 0" />
      <parent link="${prefix}J4_link" />
      <child link="${prefix}J5_link" />
      <axis xyz=" 0 -1  0" />
      <limit
        lower="${j5_lower_limit}"
        upper="${j5_upper_limit}"
        effort="${j5_effort_limit}"
        velocity="${j5_velocity_limit}"
      />
    </joint>

    <joint name="${prefix}J6" type="revolute">
      <origin xyz=" 0  0  0" rpy="0 0 0" />
      <parent link="${prefix}J5_link" />
      <child link="${prefix}J6_link" />
      <axis xyz="-1  0  0" />
      <limit
        lower="${j6_lower_limit}"
        upper="${j6_upper_limit}"
        effort="${j6_effort_limit}"
        velocity="${j6_velocity_limit}"
      />
    </joint>

    <!-- world coords -->
    <link name="${prefix}wbase" />
    <joint name="${prefix}base_link-wbase" type="fixed">
      <origin xyz=" 0  0  .67" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}wbase" />
    </joint>

    <!-- flange coords -->
    <link name="${prefix}flange" />
    <joint name="${prefix}J6-flange" type="fixed">
      <origin xyz=" .24  0  0" rpy="0 0 0" />
      <parent link="${prefix}J6_link" />
      <child link="${prefix}flange" />
    </joint>

    <!-- FANUC flange coords -->
    <link name="${prefix}fanuc_flange" />
    <joint name="${prefix}flange-fanuc_flange" type="fixed">
      <origin xyz="0 0 0" rpy="${radians( 180)} ${radians(-90)} ${radians( 0)}" />
      <parent link="${prefix}flange" />
      <child link="${prefix}fanuc_flange" />
    </joint>

    <!-- Attach to parent -->
    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}base_link" />
    </joint>

    <!-- Attach child -->
    <joint name="${prefix}child_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${prefix}flange" />
      <child link="${child}" />
    </joint>
  </xacro:macro>
</robot>
